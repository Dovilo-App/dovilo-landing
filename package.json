{
  "name": "dovilo-landing",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Build tooling for dovilo.app: the five localised pages from src/, the blog, the share cards and the site icons. Every other page is hand-written static HTML.",
  "scripts": {
    "build:pages": "node tools/build-pages.mjs",
    "build:blog": "node tools/build-blog.mjs",
    "build:og": "node tools/build-og.mjs",
    "build:icons": "node tools/build-icons.mjs",
    "serve": "python -m http.server 8000"
  },
  "engines": {
    "node": ">=20.9.0"
  },
  "dependencies": {
    "marked": "^18.0.12"
  },
  "devDependencies": {
    "sharp": "^0.35.5"
  }
}
